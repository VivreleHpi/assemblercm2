---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ETAPES, FINAL_QUIZ_QUESTIONS, PARCOURS_STATS, TIMELINE_EVENTS } from '../data';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout
  title="Espace Enseignants (EMC & Histoire Cycle 3)"
  description="Guide pédagogique pour les enseignants de CM1-CM2 (Cycle 3) : objectifs du programme officiel d'EMC, découpage en séances, Mode Classe TBI et corrigés imprimables."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-10">
    <!-- Header -->
    <header class="surface-card p-6 sm:p-8 border-t-4 border-t-republic-900">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
        <span class="px-3 py-1 rounded-full bg-republic-100 text-republic-900 text-xs font-bold">
          👩‍🏫 Ressource pédagogique Cycle 3 (CM1 · CM2 · 6e)
        </span>
        <div class="flex flex-wrap items-center gap-2 no-print">
          <button
            type="button"
            id="page-toggle-tbi-btn"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-btn bg-gold hover:bg-gold-hover text-ink font-display font-bold text-xs sm:text-sm shadow-sm min-h-[44px]"
          >
            <Icon name="Sparkles" size={16} />
            <span>Activer le Mode Classe (TBI)</span>
          </button>
          <button
            type="button"
            id="print-teacher-guide-btn"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-btn bg-republic-900 hover:bg-republic-700 text-white font-display font-bold text-xs sm:text-sm shadow-sm min-h-[44px]"
          >
            <Icon name="Printer" size={16} />
            <span>Imprimer le livret & les corrigés (PDF)</span>
          </button>
        </div>
      </div>

      <h1 class="font-display font-bold text-3xl sm:text-4xl text-ink mb-3">
        Espace Enseignants — Enseignement Moral et Civique (EMC)
      </h1>
      <p class="text-base sm:text-lg text-ink-muted max-w-3xl leading-relaxed">
        Ce parcours de 12 étapes couvre les attendus du programme officiel d’EMC et d’Histoire du Cycle 3 sur les institutions de la Ve République, l’élaboration de la loi, la séparation des pouvoirs et le rôle du citoyen.
      </p>
    </header>

    <!-- Découpage en 4 séances de 15 à 20 minutes + Parcours Express 15 minutes -->
    <section class="surface-card p-6 sm:p-8 space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-republic-700 block">
            Durées centralisées & calibrées pour la classe
          </span>
          <h2 class="font-display font-bold text-2xl text-ink mt-0.5">
            1. Parcours Complet ({PARCOURS_STATS.totalMinutes} minutes — 4 séances de 15 à 20 minutes) ou Parcours Express (15 min)
          </h2>
        </div>
        <span class="px-3.5 py-1.5 rounded-full bg-paper border border-line text-xs font-bold text-ink">
          Total des 12 fiches : {PARCOURS_STATS.totalMinutes} min ({PARCOURS_STATS.totalReadingMinutes} min lecture · {PARCOURS_STATS.totalActivityMinutes} min activités)
        </span>
      </div>

      <!-- 4 Séances de 15 à 20 minutes (65 min au total) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {PARCOURS_STATS.sessions.map((s) => (
          <div class="p-4 rounded-card bg-paper border border-line space-y-2 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between gap-2">
                <span class="px-2.5 py-0.5 rounded-full bg-republic-100 text-republic-900 text-xs font-bold">
                  Séance {s.number} ({s.durationMinutes} min)
                </span>
                <span class="text-[11px] font-bold text-ink-muted">
                  {s.stepsLabel}
                </span>
              </div>
              <h3 class="font-display font-bold text-base sm:text-lg text-ink leading-snug">
                {s.title.replace(/^Séance \d+ · /, '')}
              </h3>
              <p class="text-xs sm:text-sm text-ink-muted leading-relaxed">
                {s.summary}
              </p>
            </div>
            <div class="pt-2 border-t border-line text-[11px] font-bold text-republic-900">
              📖 {s.readingMinutes} min lecture · 🎮 {s.activityMinutes} min activités
            </div>
          </div>
        ))}
      </div>

      <!-- Parcours Court / Express 15 minutes (sélection d'extraits) -->
      <div class="p-5 rounded-card bg-gold-light/70 border-2 border-gold space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <span class="px-2.5 py-0.5 rounded-full bg-gold text-ink text-xs font-bold">
              ⚡ Option gain de temps (sélection d’extraits pour 1 séance)
            </span>
            <h3 class="font-display font-bold text-lg sm:text-xl text-ink mt-1">
              {PARCOURS_STATS.expressPath.title}
            </h3>
            <p class="text-xs sm:text-sm text-ink-muted mt-1">
              {PARCOURS_STATS.expressPath.subtitle}
            </p>
          </div>
          <span class="text-xs font-bold text-republic-900">
            4 extraits sélectionnés = {PARCOURS_STATS.expressPath.durationMinutes} minutes au TBI (ou {PARCOURS_STATS.expressPath.fullStepsDurationMinutes} min pour les 4 étapes intégrales)
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {PARCOURS_STATS.expressPath.steps.map((es) => (
            <a
              href={`/etape/${es.slug}/`}
              class="p-3.5 rounded-xl bg-surface hover:bg-republic-100 border border-line transition flex flex-col justify-between gap-2"
            >
              <div class="flex items-center justify-between text-xs font-bold">
                <span class="text-republic-900">Étape {es.number} (extrait)</span>
                <span class="px-2 py-0.5 rounded bg-paper border border-line text-ink-muted">{es.minutes} min</span>
              </div>
              <span class="font-display font-bold text-sm text-ink leading-snug">{es.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Kit Imprimable Enseignant & Classe (4 supports au choix) -->
    <section class="surface-card p-6 sm:p-8 space-y-5 no-print">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-velvet block">
          Supports papier prêts à photocopier (A4)
        </span>
        <h2 class="font-display font-bold text-2xl text-ink mt-0.5">
          2. Kit Imprimable : Choisissez le support à imprimer
        </h2>
        <p class="text-sm text-ink-muted mt-1">
          Sélectionnez le mode d’impression ci-dessous (avec ou sans les réponses corrigées) avant de cliquer sur « Imprimer ».
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <button
          type="button"
          data-print-mode="teacher-key"
          class="print-mode-btn p-4 rounded-card border-2 border-republic-900 bg-republic-100/50 text-left space-y-1 transition"
        >
          <span class="text-xs font-bold text-republic-900 uppercase block">Support 1 · Enseignant</span>
          <strong class="font-display font-bold text-base text-ink block">Livret Complet & Corrigés</strong>
          <span class="text-xs text-ink-muted block">Objectifs, traces écrites et toutes les réponses des quiz.</span>
        </button>

        <button
          type="button"
          data-print-mode="student-worksheet"
          class="print-mode-btn p-4 rounded-card border-2 border-line bg-paper hover:border-republic-900 text-left space-y-1 transition"
        >
          <span class="text-xs font-bold text-velvet uppercase block">Support 2 · Élève (sans corrigé)</span>
          <strong class="font-display font-bold text-base text-ink block">Fiche d’exercices Élève</strong>
          <span class="text-xs text-ink-muted block">Masque automatiquement les réponses pour évaluer la classe.</span>
        </button>

        <button
          type="button"
          data-print-mode="timeline-sheet"
          class="print-mode-btn p-4 rounded-card border-2 border-line bg-paper hover:border-republic-900 text-left space-y-1 transition"
        >
          <span class="text-xs font-bold text-republic-900 uppercase block">Support 3 · Histoire CM2</span>
          <strong class="font-display font-bold text-base text-ink block">Frise 1789–2026 (8 dates)</strong>
          <span class="text-xs text-ink-muted block">Récapitulatif chronologique illustré pour le cahier.</span>
        </button>

        <a
          href="/etape/6-parlement-enfants/#atelier-tribune"
          class="p-4 rounded-card border-2 border-gold bg-gold-light/60 hover:bg-gold-light text-left space-y-1 transition block"
        >
          <span class="text-xs font-bold text-republic-900 uppercase block">Support 4 · Oral en binôme</span>
          <strong class="font-display font-bold text-base text-ink block">Fiche « Parole à la Tribune »</strong>
          <span class="text-xs text-ink-muted block">Trame en 4 étapes + chronomètre 60s / 90s (Étape 6) →</span>
        </a>
      </div>
    </section>

    <!-- Support Imprimable Frise Chronologique 1789-2026 (8 repères) -->
    <section id="printable-timeline-section" class="surface-card p-6 sm:p-8 space-y-4 break-inside-avoid">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-3">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-velvet block">
            Fiche repère Histoire & EMC Cycle 3
          </span>
          <h2 class="font-display font-bold text-2xl text-ink">
            Frise Récapitulative : Les 8 Grandes Dates (1789 – Aujourd’hui)
          </h2>
        </div>
        <a href="/etape/5-frise-napoleon/" class="no-print text-xs font-bold text-republic-900 underline">
          Ouvrir la frise interactive →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
        {TIMELINE_EVENTS.map((ev) => (
          <div class="p-3.5 rounded-xl bg-paper border border-line space-y-1 text-xs sm:text-sm">
            <div class="flex items-center justify-between gap-2">
              <strong class="font-display font-bold text-velvet text-base">{ev.year} · {ev.dateLabel}</strong>
              <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-surface border border-line text-ink-muted">Repère CM2</span>
            </div>
            <p class="font-bold text-ink">{ev.title}</p>
            <p class="text-ink-muted text-xs">{ev.keyFigureOrDoc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Tableau synoptique des 12 étapes + Trace écrite + Corrigés -->
    <section class="surface-card p-6 sm:p-8 space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line pb-4">
        <div>
          <h2 class="font-display font-bold text-2xl text-ink">
            2. Fiches récapitulatives, traces écrites & corrigés des 12 étapes
          </h2>
          <p class="text-sm text-ink-muted mt-1">
            Chaque fiche ci-dessous contient le lien direct pour vidéoprojection (TBI), l’objectif du programme officiel, les 3 phrases de trace écrite et les réponses du mini-quiz.
          </p>
        </div>
      </div>

      <div class="space-y-6">
        {ETAPES.map((step) => (
          <article class="p-5 rounded-card bg-paper border border-line space-y-4 break-inside-avoid">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-republic-700">
                  Partie {step.partNumber} · Étape {step.number} / 12 (Durée : {step.duration} — {step.readingMinutes} min lecture · {step.activityMinutes} min activité)
                </span>
                <h3 class="font-display font-bold text-xl text-ink">
                  {step.title}
                </h3>
              </div>
              <a
                href={`/etape/${step.slug}/`}
                class="no-print inline-flex items-center gap-1.5 px-3.5 py-2 rounded-btn bg-surface hover:bg-republic-100 text-republic-900 border border-line text-xs font-bold"
              >
                <span>Projeter l’étape {step.number}</span>
                <Icon name="ArrowRight" size={14} />
              </a>
            </div>

            <div class="p-3.5 rounded-xl bg-republic-100/50 border border-republic-700/20 text-xs sm:text-sm text-ink">
              <strong class="text-republic-900">Objectif du programme EMC / Histoire :</strong> {step.teacherObjective}
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <!-- Trace écrite -->
              <div class="p-4 rounded-xl bg-surface border border-line space-y-2">
                <h4 class="font-display font-bold text-sm text-marianne uppercase tracking-wider">
                  Trace écrite (« Je retiens » — 3 phrases)
                </h4>
                <ol class="list-decimal list-inside space-y-1.5 text-xs sm:text-sm text-ink leading-relaxed">
                  {step.keyPoints.map((kp) => (
                    <li>{kp}</li>
                  ))}
                </ol>
              </div>

              <!-- Corrigé du mini-quiz (ou questions à compléter en mode Fiche Élève) -->
              <div class="p-4 rounded-xl bg-surface border border-line space-y-2">
                <h4 class="teacher-answer-heading font-display font-bold text-sm text-success uppercase tracking-wider">
                  Corrigé du mini-quiz (3 questions)
                </h4>
                <ul class="space-y-2.5 text-xs sm:text-sm text-ink">
                  {step.quiz.map((q, qi) => (
                    <li>
                      <strong>Q{qi + 1}. {q.question}</strong>
                      <div class="teacher-answer-key mt-0.5">
                        <span class="text-success font-bold">→ Réponse : {q.options[q.correctIndex]}</span>
                      </div>
                      <div class="student-blank-lines hidden mt-1 space-y-1 text-ink-muted">
                        {q.options.map((opt, oIdx) => (
                          <span class="block">☐ {String.fromCharCode(65 + oIdx)}. {opt}</span>
                        ))}
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Corrigé du Grand Quiz Final (8 questions) -->
    <section class="surface-card p-6 sm:p-8 space-y-4 break-inside-avoid">
      <h2 class="font-display font-bold text-2xl text-ink">
        3. Corrigé du Grand Quiz Final (Étape 11 — 8 questions)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {FINAL_QUIZ_QUESTIONS.map((fq, idx) => (
          <div class="p-4 rounded-xl bg-paper border border-line text-xs sm:text-sm space-y-1">
            <p class="font-bold text-ink">
              {idx + 1}. {fq.question}
            </p>
            <p class="text-success font-bold">
              ✓ Réponse : {fq.options[fq.correctIndex]}
            </p>
            <p class="text-ink-muted">{fq.explanation}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document.getElementById('print-teacher-guide-btn')?.addEventListener('click', () => {
    window.print();
  });
  document.getElementById('page-toggle-tbi-btn')?.addEventListener('click', () => {
    document.getElementById('toggle-classroom-btn')?.click();
  });

  const modeBtns = document.querySelectorAll<HTMLButtonElement>('.print-mode-btn');
  modeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-print-mode') || 'teacher-key';
      modeBtns.forEach((b) => {
        const active = b.getAttribute('data-print-mode') === mode;
        b.className = active
          ? 'print-mode-btn p-4 rounded-card border-2 border-republic-900 bg-republic-100/50 text-left space-y-1 transition'
          : 'print-mode-btn p-4 rounded-card border-2 border-line bg-paper hover:border-republic-900 text-left space-y-1 transition';
      });

      const isStudentWorksheet = mode === 'student-worksheet';
      document.querySelectorAll<HTMLElement>('.teacher-answer-key').forEach((el) => {
        el.classList.toggle('hidden', isStudentWorksheet);
      });
      document.querySelectorAll<HTMLElement>('.student-blank-lines').forEach((el) => {
        el.classList.toggle('hidden', !isStudentWorksheet);
      });
      document.querySelectorAll<HTMLElement>('.teacher-answer-heading').forEach((el) => {
        el.textContent = isStudentWorksheet
          ? 'Questions Élève (Coche la bonne réponse)'
          : 'Corrigé du mini-quiz (3 questions)';
      });

      if (mode === 'timeline-sheet') {
        document.getElementById('printable-timeline-section')?.scrollIntoView({ behavior: 'smooth' });
      }
      window.print();
    });
  });
</script>

