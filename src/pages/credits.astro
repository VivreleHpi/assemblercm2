---
import BaseLayout from '../layouts/BaseLayout.astro';
import Step12Credits from '../components/interactive/Step12Credits.astro';
---

<BaseLayout
  title="Crédits Photos CC BY-SA, Sources & Confidentialité"
  description="Crédits photographiques complets Wikimedia Commons (CC BY-SA / Domaine public), sources constitutionnelles et charte de confidentialité sans cookie."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-6">
    <header class="surface-card p-6 sm:p-8 border-t-4 border-t-republic-900">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <span class="px-3 py-1 rounded-full bg-republic-100 text-republic-900 text-xs font-bold">
          📸 Licences libres & Transparence
        </span>
        <a href="/#carte-parcours" class="text-xs sm:text-sm font-bold text-republic-900 hover:underline">
          ← Retour à l’accueil
        </a>
      </div>
      <h1 class="font-display font-bold text-3xl sm:text-4xl text-ink mb-2">
        Crédits, Sources Officielles & Confidentialité
      </h1>
      <p class="text-base sm:text-lg text-ink-muted max-w-2xl leading-relaxed">
        Retrouve ici toutes les attributions obligatoires des photographies sous licence Creative Commons, les textes officiels vérifiés et l’engagement « 0 collecte de données ».
      </p>
    </header>

    <Step12Credits />
  </div>
</BaseLayout>

