---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/ui/Avatar.astro';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout
  title="Page introuvable (Erreur 404)"
  description="Oups ! Tu t'es perdu dans la Salle des Pas Perdus du Palais Bourbon."
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16 text-center">
    <div class="surface-card p-8 sm:p-12 border-2 border-gold space-y-6">
      <div class="flex justify-center">
        <Avatar character="duo" size={108} />
      </div>

      <span class="inline-block px-3.5 py-1 rounded-full bg-gold-light text-ink border border-gold text-xs font-bold">
        Erreur 404 · Salle des Pas Perdus
      </span>

      <h1 class="font-display font-bold text-3xl sm:text-4xl text-ink">
        Oups ! Tu t’es égaré dans la Salle des Pas Perdus !
      </h1>

      <p class="text-base sm:text-lg text-ink-muted max-w-xl mx-auto leading-relaxed">
        Même les nouveaux députés se trompent parfois de couloir le premier jour au Palais Bourbon. Malik et son papa te ramènent tout de suite vers l’Hémicycle !
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-btn bg-gold hover:bg-gold-hover text-ink font-display font-bold text-base shadow-sm transition min-h-[48px]"
        >
          <Icon name="Compass" size={18} />
          <span>Retourner à la carte des 12 étapes</span>
        </a>

        <a
          href="/etape/1-hemicycle/"
          class="inline-flex items-center gap-2 px-5 py-3.5 rounded-btn bg-republic-900 hover:bg-republic-700 text-white font-display font-bold text-sm sm:text-base transition min-h-[48px]"
        >
          <span>Aller à l’Étape 1 (L’Hémicycle)</span>
          <Icon name="ArrowRight" size={18} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

