---
import type { BadgeItem } from '../../data';
import Icon from './Icon.astro';

interface Props {
  badge: BadgeItem;
  unlocked?: boolean;
}

const { badge, unlocked = false } = Astro.props;
---

<div
  class={`badge-card-item relative flex items-start gap-3.5 p-4 rounded-card border-2 transition-all ${
    unlocked
      ? 'bg-gold-light border-gold shadow-card'
      : 'bg-paper border-line'
  }`}
  data-badge-card={badge.id}
  data-unlocked={unlocked ? 'true' : 'false'}
>
  <div
    class={`badge-medal w-12 h-12 rounded-full flex items-center justify-center shrink-0 border-2 shadow-sm transition-colors ${
      unlocked
        ? 'bg-gold text-ink border-ink/20'
        : 'bg-surface text-ink-muted border-line'
    }`}
    aria-hidden="true"
  >
    <Icon name={badge.icon} size={24} />
  </div>
  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between gap-2">
      <h4 class="font-display font-bold text-base text-ink leading-snug">
        {badge.title}
      </h4>
      <span
        class={`badge-status-pill text-xs font-bold px-2 py-0.5 rounded-full shrink-0 ${
          unlocked
            ? 'bg-success-light text-success border border-success/30'
            : 'bg-surface text-ink-muted border border-line'
        }`}
      >
        {unlocked ? 'Débloqué ✓' : `Étape ${badge.step}`}
      </span>
    </div>
    <p class="text-xs text-ink-muted mt-1 leading-relaxed">
      {badge.description}
    </p>
  </div>
</div>

