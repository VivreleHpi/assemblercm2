---
export type AvatarCharacter = 'deputee' | 'depute' | 'malik' | 'papa' | 'duo';

interface Props {
  character?: AvatarCharacter;
  size?: number;
  class?: string;
}

const {
  character = 'deputee',
  size = 56,
  class: className = ''
} = Astro.props;

const isDuo = character === 'duo';
const widthPx = isDuo ? Math.round(size * 1.25) : size;
const heightPx = size;

const META: Record<
  AvatarCharacter,
  {
    webp: string;
    png: string;
    alt: string;
    ringClass: string;
  }
> = {
  deputee: {
    webp: '/img/avatars/avatar-deputee.webp',
    png: '/img/avatars/avatar-deputee.png',
    alt: 'Future Députée Junior CM2 (Fille)',
    ringClass: 'rounded-full border-2 border-gold bg-paper shadow-sm'
  },
  depute: {
    webp: '/img/avatars/avatar-depute.webp',
    png: '/img/avatars/avatar-depute.png',
    alt: 'Futur Député Junior CM2 (Garçon)',
    ringClass: 'rounded-full border-2 border-republic-900 bg-paper shadow-sm'
  },
  malik: {
    webp: '/img/avatars/avatar-malik.webp',
    png: '/img/avatars/avatar-malik.png',
    alt: 'Malik, élève de CM2',
    ringClass: 'rounded-full border-2 border-republic-900 bg-paper shadow-sm'
  },
  papa: {
    webp: '/img/avatars/avatar-papa.webp',
    png: '/img/avatars/avatar-papa.png',
    alt: 'Le Papa de Malik',
    ringClass: 'rounded-full border-2 border-velvet bg-paper shadow-sm'
  },
  duo: {
    webp: '/img/avatars/avatar-duo.webp',
    png: '/img/avatars/avatar-duo.png',
    alt: 'Malik et son Papa',
    ringClass: 'rounded-2xl border-2 border-gold bg-paper shadow-sm'
  }
};

const current = META[character] || META.deputee;
---

<picture
  class={`inline-block shrink-0 overflow-hidden select-none ${current.ringClass} ${className}`}
  style={`width:${widthPx}px;height:${heightPx}px;`}
>
  <source srcset={current.webp} type="image/webp" />
  <img
    src={current.png}
    alt={current.alt}
    width={widthPx}
    height={heightPx}
    loading="eager"
    decoding="async"
    class="w-full h-full object-cover object-top block"
  />
</picture>
