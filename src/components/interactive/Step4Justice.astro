---
import { PYRAMID_LEVELS, TRIBUNALS_DATA, JUSTICE_CASES } from '../../data';
import Icon from '../ui/Icon.astro';

const judicialCourts = TRIBUNALS_DATA.filter((t) => t.branch === 'judiciaire');
const adminCourts = TRIBUNALS_DATA.filter((t) => t.branch === 'administratif' || t.branch === 'constitutionnel');
---

<section class="surface-card p-5 sm:p-8 my-8 border-2 border-velvet/20">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-velvet block">
        Dossier interactif en 4 volets · Étape 4
      </span>
      <h2 class="font-display font-bold text-2xl text-ink">
        Constitution, Codes & Tribunaux de France
      </h2>
    </div>
    <span class="text-xs font-bold px-3 py-1.5 rounded-full bg-gold-light text-ink border border-gold">
      🏅 Bonus : Débloque le badge « Maître de la Justice » à l’onglet 4 !
    </span>
  </div>

  <!-- 4 Sub-section Tabs -->
  <div
    role="tablist"
    aria-label="Sous-parties Constitution et Justice"
    class="grid grid-cols-2 lg:grid-cols-4 gap-2 mb-6 bg-paper p-2 rounded-card border border-line"
  >
    <button
      type="button"
      role="tab"
      aria-selected="true"
      data-justice-tab="pyramide"
      class="justice-tab-btn px-3 py-3 rounded-btn font-display font-bold text-xs sm:text-sm bg-velvet text-white shadow-sm transition min-h-[48px]"
    >
      1. Pyramide & Codes 🔺
    </button>
    <button
      type="button"
      role="tab"
      aria-selected="false"
      data-justice-tab="parcours-loi"
      class="justice-tab-btn px-3 py-3 rounded-btn font-display font-bold text-xs sm:text-sm bg-surface text-ink hover:bg-velvet-light transition min-h-[48px]"
    >
      2. Parcours d’une loi 📜
    </button>
    <button
      type="button"
      role="tab"
      aria-selected="false"
      data-justice-tab="tribunaux"
      class="justice-tab-btn px-3 py-3 rounded-btn font-display font-bold text-xs sm:text-sm bg-surface text-ink hover:bg-velvet-light transition min-h-[48px]"
    >
      3. Les 10 tribunaux 🏛️
    </button>
    <button
      type="button"
      role="tab"
      aria-selected="false"
      data-justice-tab="jeu-tribunal"
      class="justice-tab-btn px-3 py-3 rounded-btn font-display font-bold text-xs sm:text-sm bg-surface text-ink hover:bg-velvet-light transition min-h-[48px]"
    >
      4. Jeu « Quel tribunal ? » ⚖️
    </button>
  </div>

  <!-- TAB 1: Pyramide des normes + Code civil vs Code pénal -->
  <div data-justice-panel="pyramide" class="space-y-8">
    <div>
      <h3 class="font-display font-bold text-xl text-ink mb-2">
        A. La pyramide des règles de droit (clique sur un étage)
      </h3>
      <p class="text-sm sm:text-base text-ink-muted mb-4">
        En France, toutes les règles n’ont pas la même force. Chaque étage doit obligatoirement respecter l’étage situé au-dessus de lui !
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-span-6 flex flex-col items-center space-y-2.5">
          {PYRAMID_LEVELS.map((lvl, idx) => {
            const widths = ['w-3/5', 'w-3/4', 'w-11/12', 'w-full'];
            const colors = [
              'bg-gold text-ink border-ink/20',
              'bg-velvet text-white border-velvet',
              'bg-republic-900 text-white border-republic-900',
              'bg-republic-700 text-white border-republic-700'
            ];
            return (
              <button
                type="button"
                data-pyramid-level={lvl.level}
                class={`pyramid-lvl-btn ${widths[idx]} ${colors[idx]} py-3.5 px-4 rounded-xl border-2 font-display font-bold text-center shadow-sm hover:scale-[1.02] transition min-h-[52px]`}
              >
                <span class="text-xs uppercase tracking-wider block opacity-90">{lvl.subtitle}</span>
                <span class="text-sm sm:text-base block">{lvl.level}. {lvl.title}</span>
              </button>
            );
          })}
        </div>

        <div
          id="pyramid-detail-box"
          aria-live="polite"
          class="lg:col-span-6 p-5 rounded-card bg-paper border-2 border-gold space-y-2.5"
        >
          <span id="pyramid-detail-sub" class="px-2.5 py-0.5 rounded-full bg-gold text-ink text-xs font-bold">
            {PYRAMID_LEVELS[0].subtitle}
          </span>
          <h4 id="pyramid-detail-title" class="font-display font-bold text-xl text-ink">
            {PYRAMID_LEVELS[0].title}
          </h4>
          <p id="pyramid-detail-desc" class="text-sm sm:text-base text-ink leading-relaxed">
            {PYRAMID_LEVELS[0].description}
          </p>
          <p id="pyramid-detail-ex" class="text-xs sm:text-sm text-republic-900 font-semibold bg-surface p-3 rounded-lg border border-line">
            💡 {PYRAMID_LEVELS[0].example}
          </p>
        </div>
      </div>
    </div>

    <!-- Code Civil vs Code Pénal -->
    <div class="pt-6 border-t border-line">
      <h3 class="font-display font-bold text-xl text-ink mb-4">
        B. Quelle est la différence entre le Code civil et le Code pénal ?
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="p-5 rounded-card bg-paper border-2 border-republic-900/20 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-1 rounded-full bg-republic-100 text-republic-900 text-xs font-bold">
              Créé en 1804 sous Napoléon
            </span>
            <span class="text-xl">📘</span>
          </div>
          <h4 class="font-display font-bold text-lg text-ink">Le Code civil (vivre ensemble)</h4>
          <p class="text-sm text-ink leading-relaxed">
            Il règle les relations entre les personnes dans la vie de tous les jours : la famille, le mariage, la propriété d’une maison, les contrats et la réparation d’un dégât causé à autrui.
          </p>
          <p class="text-xs font-bold text-republic-900 bg-surface p-2.5 rounded-lg border border-line">
            Objectif : Réparer un dommage ou régler un désaccord entre deux personnes (dommages-intérêts).
          </p>
        </div>

        <div class="p-5 rounded-card bg-paper border-2 border-velvet/30 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="px-2.5 py-1 rounded-full bg-velvet-light text-velvet text-xs font-bold">
              Protège la société
            </span>
            <span class="text-xl">📕</span>
          </div>
          <h4 class="font-display font-bold text-lg text-ink">Le Code pénal (interdits & sanctions)</h4>
          <p class="text-sm text-ink leading-relaxed">
            Il définit les comportements interdits qui troublent la société (les infractions) et les peines prévues, classées en 3 niveaux de gravité :
          </p>
          <ul class="text-xs sm:text-sm text-ink space-y-1 bg-surface p-3 rounded-lg border border-line">
            <li>1. <strong>Contravention</strong> (ex: griller un feu rouge) → Tribunal de police (amende).</li>
            <li>2. <strong>Délit</strong> (ex: vol, escroquerie) → Tribunal correctionnel.</li>
            <li>3. <strong>Crime</strong> (infraction la plus grave) → Cour d’assises.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 2: Parcours d'une loi en 5 étapes -->
  <div data-justice-panel="parcours-loi" class="hidden space-y-4">
    <h3 class="font-display font-bold text-xl text-ink">
      Les 5 grandes étapes de la naissance d’une loi
    </h3>
    <p class="text-sm sm:text-base text-ink-muted">
      De l’idée de départ jusqu’à sa publication officielle pour tous les citoyens :
    </p>
    <ol class="grid grid-cols-1 md:grid-cols-5 gap-3">
      <li class="p-4 rounded-card bg-paper border border-line space-y-2">
        <span class="w-8 h-8 rounded-full bg-republic-900 text-white font-display font-bold text-sm flex items-center justify-center">1</span>
        <h4 class="font-display font-bold text-base text-ink">L’initiative</h4>
        <p class="text-xs sm:text-sm text-ink-muted">
          <strong>Projet de loi</strong> (écrit par un ministre) ou <strong>proposition de loi</strong> (écrite par un député ou un sénateur).
        </p>
      </li>
      <li class="p-4 rounded-card bg-paper border border-line space-y-2">
        <span class="w-8 h-8 rounded-full bg-republic-900 text-white font-display font-bold text-sm flex items-center justify-center">2</span>
        <h4 class="font-display font-bold text-base text-ink">En commission</h4>
        <p class="text-xs sm:text-sm text-ink-muted">
          Un petit groupe de députés spécialistes étudie le texte article par article et propose des <strong>amendements</strong>.
        </p>
      </li>
      <li class="p-4 rounded-card bg-paper border border-line space-y-2">
        <span class="w-8 h-8 rounded-full bg-velvet text-white font-display font-bold text-sm flex items-center justify-center">3</span>
        <h4 class="font-display font-bold text-base text-ink">Vote & Navette</h4>
        <p class="text-xs sm:text-sm text-ink-muted">
          Débat dans l’Hémicycle puis navette entre l’Assemblée nationale (577 députés) et le Sénat (348 sénateurs).
        </p>
      </li>
      <li class="p-4 rounded-card bg-paper border border-line space-y-2">
        <span class="w-8 h-8 rounded-full bg-republic-700 text-white font-display font-bold text-sm flex items-center justify-center">4</span>
        <h4 class="font-display font-bold text-base text-ink">Vérification</h4>
        <p class="text-xs sm:text-sm text-ink-muted">
          S’il est saisi (notamment par 60 députés ou 60 sénateurs), le <strong>Conseil constitutionnel</strong> vérifie que la loi respecte la Constitution.
        </p>
      </li>
      <li class="p-4 rounded-card bg-gold-light border-2 border-gold space-y-2">
        <span class="w-8 h-8 rounded-full bg-gold text-ink font-display font-bold text-sm flex items-center justify-center">5</span>
        <h4 class="font-display font-bold text-base text-ink">Promulgation</h4>
        <p class="text-xs sm:text-sm text-ink">
          Le Président de la République signe la loi et elle est publiée au <strong>Journal officiel</strong>. Elle s’applique à tous !
        </p>
      </li>
    </ol>
  </div>

  <!-- TAB 3: Arbre des 10 tribunaux -->
  <div data-justice-panel="tribunaux" class="hidden space-y-6">
    <div>
      <h3 class="font-display font-bold text-xl text-ink mb-2">
        L’arbre de la Justice en France (2 grandes familles + les 9 Sages)
      </h3>
      <p class="text-sm text-ink-muted">
        Les députés votent la loi, mais ce sont les <strong>magistrats (juges)</strong>, indépendants des hommes politiques, qui l’appliquent dans les tribunaux.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Ordre Judiciaire -->
      <div class="p-5 rounded-card bg-paper border-2 border-republic-900/20 space-y-3">
        <div class="flex items-center justify-between border-b border-line pb-2.5">
          <h4 class="font-display font-bold text-lg text-republic-900">
            1. Ordre Judiciaire (entre personnes & infractions)
          </h4>
          <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-republic-100 text-republic-900">
            6 juridictions
          </span>
        </div>
        <div class="space-y-2.5">
          {judicialCourts.map((c) => (
            <div class="p-3.5 rounded-xl bg-surface border border-line">
              <div class="flex items-center justify-between gap-2">
                <span class="font-display font-bold text-sm sm:text-base text-ink">{c.name}</span>
                <span class="text-xs font-bold text-republic-700 shrink-0">{c.level}</span>
              </div>
              <p class="text-xs sm:text-sm text-ink-muted mt-1">{c.role}</p>
              <p class="text-xs text-ink font-semibold mt-1">Ex : {c.example}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Ordre Administratif & Conseil constitutionnel -->
      <div class="p-5 rounded-card bg-paper border-2 border-velvet/25 space-y-3">
        <div class="flex items-center justify-between border-b border-line pb-2.5">
          <h4 class="font-display font-bold text-lg text-velvet">
            2. Ordre Administratif & Constitution
          </h4>
          <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-velvet-light text-velvet">
            4 institutions
          </span>
        </div>
        <div class="space-y-2.5">
          {adminCourts.map((c) => (
            <div class="p-3.5 rounded-xl bg-surface border border-line">
              <div class="flex items-center justify-between gap-2">
                <span class="font-display font-bold text-sm sm:text-base text-ink">{c.name}</span>
                <span class="text-xs font-bold text-velvet shrink-0">{c.level}</span>
              </div>
              <p class="text-xs sm:text-sm text-ink-muted mt-1">{c.role}</p>
              <p class="text-xs text-ink font-semibold mt-1">Ex : {c.example}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 4: Mini-jeu « Quel tribunal ? » (5 affaires -> débloque le badge Justice) -->
  <div data-justice-panel="jeu-tribunal" class="hidden space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3 bg-paper p-4 rounded-card border border-line">
      <div>
        <h3 class="font-display font-bold text-lg sm:text-xl text-ink">
          Mini-jeu : Oriente ces 5 affaires vers le bon tribunal !
        </h3>
        <p class="text-xs sm:text-sm text-ink-muted">
          Trouve les 5 bonnes juridictions pour gagner la médaille <strong>« Maître de la Justice »</strong>.
        </p>
      </div>
      <span id="justice-game-score" class="px-3 py-1.5 rounded-full bg-gold-light text-ink border border-gold text-xs font-bold">
        Affaires résolues : 0 / 5
      </span>
    </div>

    <div class="space-y-4">
      {JUSTICE_CASES.map((jc, idx) => (
        <div
          class="justice-case-card p-5 rounded-card bg-paper border border-line space-y-3"
          data-case-id={jc.id}
          data-correct={jc.correctOption}
          data-explanation={jc.explanation}
        >
          <p class="font-display font-bold text-base text-ink">
            <span class="px-2 py-0.5 rounded bg-velvet-light text-velvet text-xs mr-2">
              Affaire {idx + 1}/5
            </span>
            {jc.scenario}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            {jc.options.map((opt, oIdx) => (
              <button
                type="button"
                data-case-option={oIdx}
                class="justice-opt-btn px-3.5 py-2.5 rounded-btn bg-surface hover:bg-republic-100 border-2 border-line text-ink font-bold text-xs sm:text-sm text-left transition min-h-[46px]"
              >
                {opt}
              </button>
            ))}
          </div>
          <div class="justice-case-feedback hidden p-3 rounded-xl text-xs sm:text-sm font-medium" aria-live="polite"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<script
  id="step4-pyramid-json"
  type="application/json"
  set:html={JSON.stringify(PYRAMID_LEVELS)}
/>

<script>
  function initStep4() {
    const pyrEl = document.getElementById('step4-pyramid-json');
    const pyramidLevels = pyrEl ? JSON.parse(pyrEl.textContent || '[]') : [];

    // Tabs
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.justice-tab-btn');
    const panels = document.querySelectorAll<HTMLElement>('[data-justice-panel]');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-justice-tab');
        tabBtns.forEach((b) => {
          const active = b.getAttribute('data-justice-tab') === target;
          b.setAttribute('aria-selected', String(active));
          b.className = active
            ? 'justice-tab-btn px-3 py-3 rounded-btn font-display font-bold text-xs sm:text-sm bg-velvet text-white shadow-sm transition min-h-[48px]'
            : 'justice-tab-btn px-3 py-3 rounded-btn font-display font-bold text-xs sm:text-sm bg-surface text-ink hover:bg-velvet-light transition min-h-[48px]';
        });
        panels.forEach((p) => {
          p.classList.toggle('hidden', p.getAttribute('data-justice-panel') !== target);
        });
      });
    });

    // Pyramid clicks
    document.querySelectorAll<HTMLButtonElement>('.pyramid-lvl-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lvl = Number(btn.getAttribute('data-pyramid-level'));
        const item = pyramidLevels.find((p: { level: number }) => p.level === lvl);
        if (!item) return;
        const subEl = document.getElementById('pyramid-detail-sub');
        const titleEl = document.getElementById('pyramid-detail-title');
        const descEl = document.getElementById('pyramid-detail-desc');
        const exEl = document.getElementById('pyramid-detail-ex');
        if (subEl) subEl.textContent = item.subtitle;
        if (titleEl) titleEl.textContent = `${item.level}. ${item.title}`;
        if (descEl) descEl.textContent = item.description;
        if (exEl) exEl.textContent = `💡 ${item.example}`;
      });
    });

    // Justice 5-case mini-game
    const solvedCases = new Set<number>();
    const scorePill = document.getElementById('justice-game-score');

    document.querySelectorAll<HTMLElement>('.justice-case-card').forEach((card) => {
      const caseId = Number(card.getAttribute('data-case-id'));
      const correctIdx = Number(card.getAttribute('data-correct'));
      const explanation = card.getAttribute('data-explanation') || '';
      const feedback = card.querySelector<HTMLElement>('.justice-case-feedback');
      const btns = card.querySelectorAll<HTMLButtonElement>('.justice-opt-btn');

      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const chosen = Number(btn.getAttribute('data-case-option'));
          if (chosen === correctIdx) {
            solvedCases.add(caseId);
            if (scorePill) scorePill.textContent = `Affaires résolues : ${solvedCases.size} / 5`;
            btns.forEach((b) => {
              const idx = Number(b.getAttribute('data-case-option'));
              b.className =
                idx === correctIdx
                  ? 'justice-opt-btn px-3.5 py-2.5 rounded-btn bg-success-light border-2 border-success text-success font-bold text-xs sm:text-sm text-left min-h-[46px]'
                  : 'justice-opt-btn px-3.5 py-2.5 rounded-btn bg-surface opacity-60 border border-line text-ink-muted text-xs sm:text-sm text-left min-h-[46px]';
            });
            if (feedback) {
              feedback.className = 'justice-case-feedback mt-2 p-3 rounded-xl bg-success-light border border-success/30 text-ink text-xs sm:text-sm font-medium';
              feedback.innerHTML = `<strong class="text-success">✓ Exact !</strong> ${explanation}`;
            }
            if (solvedCases.size === 5) {
              const app = (window as unknown as { ANApp?: { unlockBadge: (id: string, r: string) => void } }).ANApp;
              app?.unlockBadge('justice', 'Tu as résolu les 5 affaires du jeu Quel tribunal !');
            }
          } else {
            btn.className =
              'justice-opt-btn px-3.5 py-2.5 rounded-btn bg-error-light border-2 border-error text-error font-bold text-xs sm:text-sm text-left min-h-[46px]';
            if (feedback) {
              feedback.className = 'justice-case-feedback mt-2 p-3 rounded-xl bg-error-light border border-error/30 text-ink text-xs sm:text-sm font-medium';
              feedback.innerHTML = `<strong class="text-error">Essaie un autre tribunal :</strong> ${explanation}`;
            }
          }
        });
      });
    });
  }

  initStep4();
</script>

