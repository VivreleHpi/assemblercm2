---
import { SECRETS_DATA } from '../../data';
import Icon from '../ui/Icon.astro';
---

<section class="surface-card p-5 sm:p-8 my-8 border-2 border-republic-900/15">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-republic-700 block">
        Cartes mystères · Étape 3
      </span>
      <h2 class="font-display font-bold text-2xl text-ink">
        Retourne les 6 cartes secrètes du Palais Bourbon
      </h2>
    </div>
    <div class="flex items-center gap-2">
      <span id="secrets-counter-pill" class="text-xs font-bold px-3 py-1.5 rounded-full bg-gold-light text-ink border border-gold">
        Secrets découverts : 0 / 6
      </span>
      <button
        type="button"
        id="reveal-all-secrets-btn"
        class="px-3 py-1.5 rounded-btn bg-paper hover:bg-republic-100 text-ink border border-line text-xs font-bold min-h-[38px]"
      >
        Tout révéler
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {SECRETS_DATA.map((secret) => (
      <div class="secret-card-wrapper">
        <button
          type="button"
          class="secret-flip-btn w-full text-left rounded-card border-2 border-line bg-paper hover:border-gold p-5 transition-all flex flex-col justify-between min-h-[250px] shadow-sm"
          data-secret-id={secret.id}
          aria-expanded="false"
        >
          <!-- Front view -->
          <div class="secret-front space-y-3 w-full">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full bg-republic-100 text-republic-900 text-xs font-bold">
                Secret n° {secret.id}
              </span>
              <span class="text-xs font-bold text-republic-700 inline-flex items-center gap-1">
                <span>Cliquer pour révéler</span>
                <Icon name="Sparkles" size={14} />
              </span>
            </div>
            <h3 class="font-display font-bold text-xl text-ink pt-1">
              {secret.title}
            </h3>
            <p class="text-sm sm:text-base text-ink-muted font-medium leading-relaxed">
              ❓ {secret.frontQuestion}
            </p>
          </div>

          <!-- Back view (Revealed) -->
          <div class="secret-back hidden space-y-3 w-full">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-full bg-gold text-ink text-xs font-bold">
                Secret n° {secret.id} révélé ✓
              </span>
              <span class="text-xs text-white/80 font-semibold">
                Cliquer pour refermer
              </span>
            </div>
            <h3 class="font-display font-bold text-lg text-gold">
              {secret.backTitle}
            </h3>
            <p class="text-sm text-white/95 leading-relaxed">
              {secret.backText}
            </p>
          </div>

          <div class="w-full pt-3 mt-3 border-t border-line/60 flex items-center justify-between text-xs font-bold text-ink-muted secret-footer-bar">
            <span>Anecdote vérifiée</span>
            <span class="secret-action-label text-republic-900">Retourner la carte ↻</span>
          </div>
        </button>
      </div>
    ))}
  </div>
</section>

<script>
  function initStep3() {
    const revealed = new Set<number>();
    const counterEl = document.getElementById('secrets-counter-pill');
    const cards = document.querySelectorAll<HTMLButtonElement>('.secret-flip-btn');

    const updateCardAppearance = (btn: HTMLButtonElement, isOpen: boolean) => {
      const front = btn.querySelector('.secret-front');
      const back = btn.querySelector('.secret-back');
      const footer = btn.querySelector('.secret-footer-bar');
      const actionLabel = btn.querySelector('.secret-action-label');

      btn.setAttribute('aria-expanded', String(isOpen));
      front?.classList.toggle('hidden', isOpen);
      back?.classList.toggle('hidden', !isOpen);

      if (isOpen) {
        btn.className =
          'secret-flip-btn w-full text-left rounded-card border-2 border-gold bg-night text-white p-5 transition-all flex flex-col justify-between min-h-[250px] shadow-card';
        if (footer) footer.className = 'w-full pt-3 mt-3 border-t border-white/20 flex items-center justify-between text-xs font-bold text-white/80 secret-footer-bar';
        if (actionLabel) {
          actionLabel.textContent = 'Voir la question ↺';
          actionLabel.className = 'secret-action-label text-gold';
        }
      } else {
        btn.className =
          'secret-flip-btn w-full text-left rounded-card border-2 border-line bg-paper hover:border-gold p-5 transition-all flex flex-col justify-between min-h-[250px] shadow-sm';
        if (footer) footer.className = 'w-full pt-3 mt-3 border-t border-line/60 flex items-center justify-between text-xs font-bold text-ink-muted secret-footer-bar';
        if (actionLabel) {
          actionLabel.textContent = 'Retourner la carte ↻';
          actionLabel.className = 'secret-action-label text-republic-900';
        }
      }
    };

    const syncCounter = () => {
      if (counterEl) {
        counterEl.textContent = `Secrets découverts : ${revealed.size} / 6`;
      }
    };

    cards.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = Number(btn.getAttribute('data-secret-id'));
        const currentlyOpen = btn.getAttribute('aria-expanded') === 'true';
        const nextOpen = !currentlyOpen;
        if (nextOpen) revealed.add(id);
        updateCardAppearance(btn, nextOpen);
        syncCounter();
      });
    });

    document.getElementById('reveal-all-secrets-btn')?.addEventListener('click', () => {
      cards.forEach((btn) => {
        const id = Number(btn.getAttribute('data-secret-id'));
        revealed.add(id);
        updateCardAppearance(btn, true);
      });
      syncCounter();
    });
  }

  initStep3();
</script>

