---
import Icon from '../ui/Icon.astro';

const themes = [
  {
    id: 'culture',
    label: '🎭 Accès à la culture (Thème 30e éd. 2026–2027)',
    title: 'Proposition de loi visant à créer un « Carnet Découverte Culture » pour chaque élève de CM2 et de 6e',
    expose:
      'S’inspirant du thème officiel de la 30e édition (« Favoriser l’accès à la culture pour toutes et tous »), cet exemple fictif propose que chaque enfant puisse visiter gratuitement un musée, un théâtre, une médiathèque ou un monument historique près de chez lui avec sa classe et sa famille.',
    article1:
      'Article 1er : Un parcours culturel annuel comprenant au moins deux sorties artistiques ou patrimoniales et une rencontre avec un artiste ou un artisan d’art est organisé dans toutes les classes de cycle 3 (CM1, CM2, 6e).'
  },
  {
    id: 'ecologie',
    label: '🌳 Écologie & Nature à l’école',
    title: 'Proposition de loi visant à créer des cours d’école végétalisées et des refuges pour la biodiversité',
    expose:
      'Pour lutter contre la chaleur et protéger les oiseaux et les insectes pollinisateurs, chaque école primaire et collège aménage un espace de pleine terre et un hôtel à insectes entretenu par les élèves.',
    article1:
      'Article 1er : Dans chaque commune, les cours d’école primaire comportent au moins un espace végétalisé ombragé et un récupérateur d’eau de pluie à usage pédagogique.'
  },
  {
    id: 'numerique',
    label: '📱 Écrans & Protection des enfants',
    title: 'Proposition de loi pour un permis citoyen du numérique en CM2 et en 6e',
    expose:
      'Les élèves utilisent de plus en plus tôt Internet et les jeux en ligne. Il est essentiel de leur apprendre à protéger leurs données personnelles et à prévenir le cyberharcèlement.',
    article1:
      'Article 1er : Une formation annuelle au respect d’autrui en ligne et à la vérification des sources d’information est organisée dans toutes les classes de CM2 et de 6e.'
  },
  {
    id: 'sport',
    label: '🏃‍♀️ Sport, Santé & Solidarité',
    title: 'Proposition de loi favorisant la découverte du handisport et des jeux paralympiques à l’école',
    expose:
      'Le sport permet de rassembler tous les enfants. Découvrir le cécifoot, la boccia ou le basket fauteuil aide à changer de regard sur le handicap.',
    article1:
      'Article 1er : Chaque année scolaire, les élèves de cycle 3 participent à une journée d’initiation aux disciplines handisport en lien avec les associations locales.'
  }
];
---

<section class="surface-card p-5 sm:p-8 my-8 border-2 border-velvet/20 space-y-8">
  <div class="space-y-3">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <span class="text-xs font-bold uppercase tracking-wider text-velvet block">
        Opération civique nationale · Créée en 1994 · 30e édition (2026–2027)
      </span>
      <a
        href="https://www.parlementdesenfants.fr/site/tout-savoir-sur-l-operation"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-republic-900 underline hover:text-velvet"
      >
        Site officiel parlementdesenfants.fr ↗
      </a>
    </div>
    <h2 class="font-display font-bold text-2xl text-ink">
      Comment fonctionne le Parlement des enfants (classes de CM2 et de 6e) ?
    </h2>
    <p class="text-sm sm:text-base text-ink-muted leading-relaxed">
      Organisé par l’Assemblée nationale et le ministère de l’Éducation nationale, le Parlement des enfants réunit des classes de <strong>CM2</strong> et de <strong>6e</strong> (577 circonscriptions + classes des Français de l’étranger). Pour la <strong>30e édition (année scolaire 2026–2027)</strong>, le thème officiel est : <strong>« Favoriser l’accès à la culture pour toutes et tous »</strong>.
    </p>
  </div>

  <!-- 5 Official Steps of Parlement des enfants (30e édition 2026-2027) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
    <div class="p-4 rounded-card bg-paper border border-line space-y-2">
      <span class="px-2.5 py-0.5 rounded-full bg-republic-100 text-republic-900 text-xs font-bold">
        1 · Sept. – Oct. 2026
      </span>
      <h3 class="font-display font-bold text-base text-ink">Sélection des classes</h3>
      <p class="text-xs sm:text-sm text-ink-muted leading-relaxed">
        Les classes candidates de <strong>CM2</strong> et de <strong>6e</strong> sont sélectionnées par les autorités académiques dans les 577 circonscriptions et à l’étranger.
      </p>
    </div>

    <div class="p-4 rounded-card bg-paper border border-line space-y-2">
      <span class="px-2.5 py-0.5 rounded-full bg-republic-100 text-republic-900 text-xs font-bold">
        2 · Nov. 2026 – Janv. 2027
      </span>
      <h3 class="font-display font-bold text-base text-ink">Rédaction en classe</h3>
      <p class="text-xs sm:text-sm text-ink-muted leading-relaxed">
        Avec leur enseignant et la visite du député de leur circonscription, les élèves débattent du thème et rédigent leur proposition de loi.
      </p>
    </div>

    <div class="p-4 rounded-card bg-paper border border-line space-y-2">
      <span class="px-2.5 py-0.5 rounded-full bg-velvet-light text-velvet text-xs font-bold">
        3 · 3 ou 4 février 2027
      </span>
      <h3 class="font-display font-bold text-base text-ink">Jurys & Jury national</h3>
      <p class="text-xs sm:text-sm text-ink-muted leading-relaxed">
        Après les jurys académiques, le <strong>jury national</strong> (programmation officielle : 3 ou 4 février 2027) sélectionne les propositions finalistes (CM2 et 6e).
      </p>
    </div>

    <div class="p-4 rounded-card bg-paper border border-line space-y-2">
      <span class="px-2.5 py-0.5 rounded-full bg-gold-light text-ink border border-gold text-xs font-bold">
        4 · Jusqu’au 5 mars 2027
      </span>
      <h3 class="font-display font-bold text-base text-ink">Vote électronique</h3>
      <p class="text-xs sm:text-sm text-ink-muted leading-relaxed">
        Toutes les classes participantes étudient les textes finalistes, débattent et votent en ligne (fin des votes programmée le <strong>5 mars 2027</strong>).
      </p>
    </div>

    <div class="p-4 rounded-card bg-gold-light border-2 border-gold space-y-2">
      <span class="px-2.5 py-0.5 rounded-full bg-gold text-ink text-xs font-bold">
        5 · 10 mars 2027
      </span>
      <h3 class="font-display font-bold text-base text-ink">Accueil au Palais Bourbon</h3>
      <p class="text-xs sm:text-sm text-ink leading-relaxed">
        Les classes finalistes sont accueillies à l’Assemblée nationale (date programmée : <strong>10 mars 2027</strong>) pour la proclamation des lauréats !
      </p>
    </div>
  </div>

  <!-- Interactive Bill Builder -->
  <div class="pt-6 border-t border-line space-y-4">
    <div class="space-y-1">
      <h3 class="font-display font-bold text-xl text-ink">
        Atelier d’entraînement : Explore 4 exemples fictifs de propositions de loi
      </h3>
      <p class="text-xs sm:text-sm text-ink-muted">
        Ces exemples sont des <strong>simulations pédagogiques imaginées pour t’entraîner sur ce site</strong> : ils ne constituent pas le règlement ni un formulaire officiel du concours.
      </p>
    </div>
    <div class="flex flex-wrap gap-2.5" role="group" aria-label="Thèmes d'exemples pédagogiques de proposition de loi">
      {themes.map((t, idx) => (
        <button
          type="button"
          data-pde-theme={t.id}
          class={`pde-theme-btn px-4 py-2.5 rounded-btn font-display font-bold text-xs sm:text-sm border-2 transition min-h-[46px] ${
            idx === 0
              ? 'bg-republic-900 text-white border-republic-900 shadow-sm'
              : 'bg-paper text-ink border-line hover:bg-republic-100'
          }`}
        >
          {t.label}
        </button>
      ))}
    </div>

    <div
      id="pde-bill-preview"
      aria-live="polite"
      class="p-6 rounded-card bg-paper border-2 border-republic-900/25 shadow-sm space-y-3"
    >
      <div class="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-line">
        <span class="text-xs font-bold uppercase tracking-wider text-republic-900">
          Exercice de simulation citoyenne · Cycle 3 (CM2 &amp; 6e)
        </span>
        <span class="px-2.5 py-0.5 rounded-full bg-gold-light text-ink border border-gold text-xs font-bold">
          Exemple fictif et pédagogique (non officiel)
        </span>
      </div>
      <h4 id="pde-bill-title" class="font-display font-bold text-lg sm:text-xl text-ink">
        {themes[0].title}
      </h4>
      <div class="p-3.5 rounded-xl bg-surface border border-line text-xs sm:text-sm text-ink-muted leading-relaxed">
        <strong class="text-ink block mb-1">Exposé des motifs (Pourquoi cette loi ?) :</strong>
        <span id="pde-bill-expose">{themes[0].expose}</span>
      </div>
      <div class="p-4 rounded-xl bg-republic-100/50 border border-republic-700/20 text-sm sm:text-base text-ink font-medium leading-relaxed">
        <span id="pde-bill-article">{themes[0].article1}</span>
      </div>
    </div>
  </div>
</section>

<script
  id="step6-themes-json"
  type="application/json"
  set:html={JSON.stringify(themes)}
/>

<script>
  function initStep6() {
    const jsonEl = document.getElementById('step6-themes-json');
    const themes = jsonEl ? JSON.parse(jsonEl.textContent || '[]') : [];
    const btns = document.querySelectorAll<HTMLButtonElement>('.pde-theme-btn');

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-pde-theme');
        const theme = themes.find((t: { id: string }) => t.id === id);
        if (!theme) return;

        btns.forEach((b) => {
          const active = b.getAttribute('data-pde-theme') === id;
          b.className = `pde-theme-btn px-4 py-2.5 rounded-btn font-display font-bold text-xs sm:text-sm border-2 transition min-h-[46px] ${
            active
              ? 'bg-republic-900 text-white border-republic-900 shadow-sm'
              : 'bg-paper text-ink border-line hover:bg-republic-100'
          }`;
        });

        const titleEl = document.getElementById('pde-bill-title');
        const expEl = document.getElementById('pde-bill-expose');
        const artEl = document.getElementById('pde-bill-article');
        if (titleEl) titleEl.textContent = theme.title;
        if (expEl) expEl.textContent = theme.expose;
        if (artEl) artEl.textContent = theme.article1;
      });
    });
  }

  initStep6();
</script>

