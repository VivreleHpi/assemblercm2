---
import Icon from '../ui/Icon.astro';
import Avatar from '../ui/Avatar.astro';

interface Props {
  currentStepNumber?: number;
}

const { currentStepNumber } = Astro.props;
---

<header class="sticky top-0 z-40 bg-surface/95 backdrop-blur-md border-b border-line shadow-sm no-print">
  <!-- Tricolor thin top ribbon -->
  <div class="h-1 w-full flex" aria-hidden="true">
    <div class="w-1/3 bg-republic-900"></div>
    <div class="w-1/3 bg-surface"></div>
    <div class="w-1/3 bg-marianne"></div>
  </div>

  <div class="max-w-7xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2 sm:gap-4">
    <!-- 1. Logo + Nom -->
    <a
      href="/"
      class="flex items-center gap-2.5 min-w-0 shrink py-1.5 rounded-btn focus-visible:outline-none"
      title="Accueil — L'Assemblée nationale, le parcours de Malik et son Papa"
    >
      <span class="w-10 h-10 rounded-xl bg-republic-900 text-gold flex items-center justify-center shrink-0 shadow-sm border border-gold/40">
        <Icon name="Landmark" size={22} />
      </span>
      <div class="min-w-0">
        <span class="font-display font-bold text-sm sm:text-base text-ink block truncate leading-tight">
          L’Assemblée nationale
        </span>
        <span class="text-xs text-ink-muted block truncate leading-tight">
          Parcours CM2 · Malik & Papa
        </span>
      </div>
    </a>

    <!-- 2. Progression « Étape X/12 » + barre -->
    <a
      href="/#carte-parcours"
      class="hidden md:flex items-center gap-3 px-3.5 py-2 rounded-btn bg-paper hover:bg-republic-100/60 border border-line transition min-h-[44px]"
      title="Voir la carte des 12 étapes"
    >
      <div class="text-left">
        <div class="flex items-center justify-between gap-3 text-xs font-bold text-ink">
          <span id="header-step-label">
            {currentStepNumber ? `Étape ${currentStepNumber} / 12` : 'Parcours : 0 / 12'}
          </span>
          <span id="header-progress-pct" class="text-republic-700">0%</span>
        </div>
        <div class="w-36 h-2 rounded-full bg-line overflow-hidden mt-1" role="progressbar" aria-label="Progression du parcours" aria-valuemin="0" aria-valuemax="12" aria-valuenow="0" id="header-progressbar">
          <div id="header-progress-fill" class="h-full bg-republic-900 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>
    </a>

    <!-- Right actions: 3. Recherche (Ctrl+K) + 4. Profil & Réglages -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <!-- 3. Recherche -->
      <button
        type="button"
        data-open-modal="search-modal"
        class="inline-flex items-center gap-2 px-3 py-2 rounded-btn bg-paper hover:bg-republic-100 text-ink border border-line text-xs sm:text-sm font-semibold transition min-h-[44px] min-w-[44px] justify-center"
        title="Rechercher un mot, une étape ou un quiz (Raccourci Ctrl+K)"
      >
        <Icon name="Search" size={18} />
        <span class="sr-only lg:not-sr-only">Rechercher</span>
        <kbd class="hidden xl:inline-block px-1.5 py-0.5 text-xs bg-surface border border-line rounded text-ink-muted font-mono">
          Ctrl+K
        </kbd>
      </button>

      <!-- Badge Mode Classe TBI (visible uniquement quand Mode Classe est actif) -->
      <span
        id="header-classroom-pill"
        class="classroom-only-pill hidden items-center gap-1.5 px-3 py-1.5 rounded-btn bg-republic-900 text-gold border-2 border-gold font-display font-bold text-xs sm:text-sm min-h-[44px]"
        title="Projection collective en classe (compteurs XP individuels masqués)"
      >
        <span>👩‍🏫 Mode Classe / TBI</span>
      </span>

      <!-- 4. Bouton Profil (Avatar + XP + Badges) -->
      <button
        type="button"
        id="header-profile-btn"
        data-open-modal="profile-modal"
        class="student-profile-btn inline-flex items-center gap-2 px-2.5 sm:px-3.5 py-1.5 rounded-btn bg-gold-light hover:bg-gold/40 text-ink border-2 border-gold font-display font-bold text-xs sm:text-sm transition min-h-[44px]"
        title="Ouvrir mon profil Député Junior, mes XP et mes 9 badges"
      >
        <span id="header-avatar-deputee" class="shrink-0 hidden">
          <Avatar character="deputee" size={28} />
        </span>
        <span id="header-avatar-depute" class="shrink-0">
          <Avatar character="depute" size={28} />
        </span>
        <span id="header-avatar-malik" class="shrink-0 hidden">
          <Avatar character="malik" size={28} />
        </span>
        <span id="header-avatar-papa" class="shrink-0 hidden">
          <Avatar character="papa" size={28} />
        </span>
        <span id="header-user-name" class="sr-only sm:not-sr-only max-w-[90px] truncate text-ink">
          Explorateur
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-gold text-ink text-xs font-bold">
          <span id="header-xp-count">0</span>
          <span>XP</span>
        </span>
        <span class="hidden md:inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-surface text-ink border border-line text-xs font-bold">
          <span>🏅</span>
          <span id="header-badge-count">0/9</span>
        </span>
      </button>

      <!-- Menu Réglages (Mode Classe, Son, Taille du texte, Dys, Réinitialisation) -->
      <div class="relative">
        <button
          type="button"
          id="settings-menu-button"
          aria-expanded="false"
          aria-controls="settings-dropdown"
          class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-btn bg-paper hover:bg-republic-100 text-ink border border-line text-xs sm:text-sm font-semibold transition min-h-[44px] min-w-[44px]"
          title="Réglages d'affichage, son et Mode Classe"
        >
          <Icon name="Settings" size={18} />
          <span class="sr-only xl:not-sr-only">Réglages</span>
        </button>

        <div
          id="settings-dropdown"
          role="region"
          aria-label="Menu des réglages"
          class="hidden absolute right-0 mt-2 w-72 sm:w-80 rounded-card bg-surface border-2 border-line shadow-elevated p-4 z-50 space-y-3.5"
        >
          <div class="flex items-center justify-between pb-2 border-b border-line">
            <span class="font-display font-bold text-sm text-ink">Réglages & Accessibilité</span>
            <button
              type="button"
              id="settings-close-btn"
              class="p-1.5 rounded-lg hover:bg-paper text-ink-muted"
              aria-label="Fermer les réglages"
            >
              <Icon name="X" size={16} />
            </button>
          </div>

          <!-- Taille du texte -->
          <div>
            <span class="text-xs font-bold text-ink-muted block mb-1.5">Taille du texte</span>
            <div class="grid grid-cols-3 gap-1.5" role="group" aria-label="Choisir la taille du texte">
              <button
                type="button"
                data-font-size-btn="normal"
                class="px-2.5 py-2 rounded-lg border border-line bg-paper text-xs font-bold text-ink hover:bg-republic-100 min-h-[40px]"
              >
                100%
              </button>
              <button
                type="button"
                data-font-size-btn="large"
                class="px-2.5 py-2 rounded-lg border border-line bg-paper text-xs font-bold text-ink hover:bg-republic-100 min-h-[40px]"
              >
                115%
              </button>
              <button
                type="button"
                data-font-size-btn="xlarge"
                class="px-2.5 py-2 rounded-lg border border-line bg-paper text-xs font-bold text-ink hover:bg-republic-100 min-h-[40px]"
              >
                130%
              </button>
            </div>
          </div>

          <!-- Mode Confort Dys -->
          <div class="flex items-center justify-between gap-2 pt-1">
            <div>
              <span class="text-xs font-bold text-ink block">Espacement lecture (Dys)</span>
              <span class="text-xs text-ink-muted block">Lettres et mots plus aérés</span>
            </div>
            <button
              type="button"
              id="toggle-dys-btn"
              aria-pressed="false"
              class="px-3 py-1.5 rounded-full border border-line bg-paper text-xs font-bold text-ink min-h-[38px]"
            >
              Désactivé
            </button>
          </div>

          <!-- Mode Classe (TBI) -->
          <div class="flex items-center justify-between gap-2 pt-1">
            <div>
              <span class="text-xs font-bold text-ink block">Mode Classe / TBI</span>
              <span class="text-xs text-ink-muted block">Grands caractères pour projection</span>
            </div>
            <button
              type="button"
              id="toggle-classroom-btn"
              aria-pressed="false"
              class="px-3 py-1.5 rounded-full border border-line bg-paper text-xs font-bold text-ink min-h-[38px]"
            >
              Désactivé
            </button>
          </div>

          <!-- Effets sonores -->
          <div class="flex items-center justify-between gap-2 pt-1">
            <div>
              <span class="text-xs font-bold text-ink block">Effets sonores (cloche, tambour)</span>
              <span class="text-xs text-ink-muted block">Synthèse audio Web</span>
            </div>
            <button
              type="button"
              id="toggle-sound-btn"
              aria-pressed="true"
              class="px-3 py-1.5 rounded-full border border-success/40 bg-success-light text-xs font-bold text-success min-h-[38px]"
            >
              Activé 🔔
            </button>
          </div>

          <!-- Liens rapides Enseignants & Glossaire -->
          <div class="pt-2 border-t border-line grid grid-cols-2 gap-2">
            <a
              href="/enseignants/"
              class="px-2.5 py-2 rounded-lg bg-paper hover:bg-republic-100 text-xs font-bold text-republic-900 text-center border border-line"
            >
              Espace Enseignants
            </a>
            <a
              href="/glossaire/"
              class="px-2.5 py-2 rounded-lg bg-paper hover:bg-republic-100 text-xs font-bold text-republic-900 text-center border border-line"
            >
              Glossaire CM2
            </a>
          </div>

          <!-- Tout effacer -->
          <div class="pt-2 border-t border-line">
            <button
              type="button"
              id="reset-all-progress-btn"
              class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-lg bg-error-light hover:bg-error text-error hover:text-white text-xs font-bold transition min-h-[40px]"
            >
              <Icon name="RotateCcw" size={14} />
              <span>Tout effacer (réinitialiser)</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

